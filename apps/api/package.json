{
  "name": "@notification-service/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "wrangler types --check && tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "types": "wrangler types --env-file .dev.vars.example",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "build": "wrangler deploy --dry-run --outdir dist && wrangler deploy --config qa/wrangler.jsonc --dry-run --outdir dist/qa",
    "openapi": "vitest run test/openapi.test.ts --update",
    "check-alerts": "node scripts/check-alerts.mjs"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "@notification-service/db": "workspace:*",
    "asn1js": "4.0.0",
    "cborg": "6.2.1",
    "hono": "4.13.14",
    "pkijs": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
