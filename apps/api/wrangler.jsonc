{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notification-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  // Wrangler の利用状況を Cloudflare に送らない。
  "send_metrics": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notification-service",
      // オーナーが承認した sandbox 検証用の D1 (2026-11-04)。
      "database_id": "b19c69b6-066d-4cf0-a0c0-8274ae6f2d3d",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // 登録とセッションの回数の制限 (src/security/rate-limit.ts、ADR-0006)。数は Cloudflare の場所ごとのおおよその数。
  // namespace_id は、Cloudflare のアカウントの中で制限を見分ける数。ほかの Worker と同じ数にすると、数を分け合う
  // (使っている番号は ADR-0006 に書く)。
  "ratelimits": [
    {
      // 接続元の IP (IPv6 は /64) ごと。チャレンジ、登録、セッションの作り直しを合わせて数える (1 回の登録で 2 回)。
      "name": "CLIENT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      // インストールごと。用途ごとに単位を分けて数える: セッションを作るもの (作り直し、同じ鍵での登録し直し)、
      // 中継の資格情報の入れ替え (署名を確かめた後)、取り消し (ADR-0006、ADR-0007)。
      "name": "INSTALLATION_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      // APNs のトークンごと。アカウントをまたいで、確かめの push を送る回数を数える (ADR-0008)。
      // 1 つのインストールが 1 つのトークンへ送れるのは INSTALLATION_RATE_LIMITER の 5 回までなので、1 つでは使い切れない。
      "name": "TOKEN_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // アカウントごと。中継の資格情報を確かめた後の、イベントの受け付けを数える (ADR-0009)。1 日の上限は DB で数える。
      "name": "RELAY_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  // 定期の掃除 (src/maintenance.ts、src/index.ts の CLEANUP_CRON と CLEANUPS)。どれも 1 日 1 回。Cron は UTC なので、日本時間の
  // 3:17〜3:47。1 回の呼び出しで D1 に投げる問い合わせの数に上限があるので (無料のプランで 50)、発火する分ごとに掃除を分ける。
  // 掃除は式1つにまとめる。別の5分Cronは、Queueの待機と観測失敗だけを監視する。
  "triggers": {
    "crons": ["17,27,37,47 18 * * *", "*/5 * * * *"]
  },
  "vars": {
    "APP_ATTEST_POLICY": "{\"mode\":\"invite_only\",\"appId\":\"PU5HXZ4FZ2.com.twitter-studio.Tweetbot\",\"environment\":\"development\",\"bundleVersions\":[\"1\"]}",
    // 端末の登録で受け付ける topic (Bundle ID)。カンマ区切り (ADR-0008)。
    "APNS_TOPICS": "com.twitter-studio.Tweetbot",
    // sandbox の鍵の確かめの値 (秘密ではない。ADR-0005)。鍵の値は Cloudflare secret に置く。
    "DEVICE_TOKEN_KEY_CHECKS": "{\"fingerprint\":\"a0060dbb57486aa9\",\"keys\":{\"sandbox-20261104\":\"54a78f72b1bcee14\"}}"
  },
  // オーナーが承認した sandbox 検証用の再送 Queue。保存は24時間に制限する。
  "queues": {
    "producers": [{ "binding": "APNS_RETRIES", "queue": "notification-apns-retries" }],
    "consumers": [{ "queue": "notification-apns-retries", "max_batch_size": 1, "max_retries": 1 }]
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
