{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notification-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  // Wrangler の利用状況を Cloudflare に送らない。
  "send_metrics": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notification-service",
      // 手元とテスト用の仮の ID。本番の D1 はオーナーの承認を得てから作り、ここを本物の ID にする (仮の ID のままではデプロイできない)。
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // 登録とセッションの回数の制限 (src/security/rate-limit.ts、ADR-0006)。数は Cloudflare の場所ごとのおおよその数。
  // namespace_id は、Cloudflare のアカウントの中で制限を見分ける数。ほかの Worker と同じ数にすると、数を分け合う。
  "ratelimits": [
    {
      // 接続元の IP ごと。チャレンジ、登録、セッションの作り直しを合わせて数える (1 回の登録で 2 回)。
      "name": "CLIENT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      // インストールごと。署名を確かめたあとの、セッションの作り直しを数える。
      "name": "INSTALLATION_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // 受け付けの記録の定期の掃除 (src/maintenance.ts)。1 日 1 回。Cron は UTC なので、日本時間の 3:17。
  "triggers": {
    "crons": ["17 18 * * *"]
  },
  "vars": {
    // 鍵の確かめの値 (秘密ではない。ADR-0005)。本番の鍵を作ったら、scripts/key-check.mjs で作った値に置き換える。
    // 空のままでは、鍵を読むときに失敗する (確かめずに鍵を使わないため)。
    "DEVICE_TOKEN_KEY_CHECKS": "{\"fingerprint\":\"\",\"keys\":{}}"
  },
  "observability": {
    "enabled": true
  }
}
