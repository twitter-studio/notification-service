# 手元で使う秘密の名前の一覧 (値は書かない)。手元では、この名前で .dev.vars (コミットしない) に値を置く。
# 型 (worker-configuration.d.ts) は、このファイルから作る。秘密を足したら、ここにも名前を足して `pnpm --filter @notification-service/api types` を動かす。

# APNs のデバイストークンを暗号化する鍵束 (JSON)。{"current":"<鍵の ID>","keys":{"<鍵の ID>":"<32 バイトの Base64>"}} (ADR-0005)。
DEVICE_TOKEN_KEYS=
# デバイストークンの指紋 (HMAC-SHA256) の鍵 (32 バイトの Base64)。
DEVICE_TOKEN_FINGERPRINT_KEY=
