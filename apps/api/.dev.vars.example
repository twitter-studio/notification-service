# 手元で使う秘密の名前の一覧 (値は書かない)。手元では、この名前で .dev.vars (コミットしない) に値を置く。
# 型 (worker-configuration.d.ts) は、このファイルから作る。秘密を足したら、ここにも名前を足して `pnpm --filter @notification-service/api types` を動かす。

# APNs のデバイストークンを暗号化する鍵束 (JSON)。{"current":"<鍵の ID>","keys":{"<鍵の ID>":"<32 バイトの Base64>"}} (ADR-0005)。
DEVICE_TOKEN_KEYS=
# デバイストークンの指紋 (HMAC-SHA256) の鍵 (32 バイトの Base64)。
DEVICE_TOKEN_FINGERPRINT_KEY=

# 登録とセッションの作り直しのチャレンジに署名する鍵 (32 バイトの Base64。ADR-0006)。デバイストークンの鍵とは別の値にし、環境ごとに作る。
CHALLENGE_SIGNING_KEY=
# 登録の招待のコード (試作のあいだ、登録をテスト用の人に限る。ADR-0006)。16 バイト以上の乱数の Base64URL (22 文字以上)。
# 空のとき、短いときは、登録を受け付けない。作り方: node -e 'console.log(crypto.randomBytes(16).toString("base64url"))'
ENROLLMENT_INVITE_CODE=

# 鍵の確かめの値 (秘密ではない) は wrangler.jsonc の vars にある。手元の鍵で動かすときは、手元の鍵の値を .dev.vars で上書きする。
# DEVICE_TOKEN_KEY_CHECKS={"fingerprint":"<値>","keys":{"<鍵の ID>":"<値>"}}
