  "info": {
    "title": "Sandbox APNs probe",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "probe": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/probe": {
      "post": {
        "operationId": "probeSandboxApns",
        "security": [
          {
            "probe": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "device_token": {
                    "type": "string",
                    "pattern": "^(?:[0-9a-f]{2}){16,128}$"
                  }
                },
                "required": [
                  "device_token"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "APNs に1回だけ送った結果。端末への到達は別に確認する。",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "apns_response"
                          ]
                        },
                        "request_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "elapsed_ms": {
                          "type": "number",
                          "minimum": 0
                        },
                        "http_protocol": {
                          "type": "string",
                          "enum": [
                            "not_exposed"
                          ]
                        },
                        "cpu_ms": {
                          "type": "null"
                        },
                        "status": {
                          "type": "integer"
                        },
                        "apns_id": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "uuid"
                        },
                        "reason": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "enum": [
                            "BadDeviceToken",
                            "DeviceTokenNotForTopic",
                            "InvalidProviderToken",
                            "ExpiredProviderToken",
                            "TopicDisallowed",
                            "Unregistered",
                            "TooManyRequests",
                            "TooManyProviderTokenUpdates",
                            "other",
                            null
                          ]
                        }
                      },
                      "required": [
                        "kind",
                        "request_id",
                        "elapsed_ms",
                        "http_protocol",
                        "cpu_ms",
                        "status",
                        "apns_id",
                        "reason"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "transport_error"
                          ]
                        },
                        "request_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "elapsed_ms": {
                          "type": "number",
                          "minimum": 0
                        },
                        "http_protocol": {
                          "type": "string",
                          "enum": [
                            "not_exposed"
                          ]
                        },
                        "cpu_ms": {
                          "type": "null"
                        }
                      },
                      "required": [
                        "kind",
                        "request_id",
                        "elapsed_ms",
                        "http_protocol",
                        "cpu_ms"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "秘密や要求の値を含まない problem details。",
